# FastAPI
APP_ENV=local
APP_HOST=0.0.0.0
APP_PORT=8000

# PostgreSQL / PostGIS
# 로컬에서 `uvicorn`을 직접 실행할 때 값(호스트에 노출된 포트 기준).
# docker-compose로 api까지 함께 띄울 때는 infra/docker-compose.yml이 postgres/redis
# 서비스명으로 이 값을 덮어써서 컨테이너 내부망을 쓴다.
DATABASE_URL=postgresql+psycopg://aeroops:aeroops@localhost:5432/aeroops

# Redis Streams — 호스트/포트/DB는 REDIS_URL(관리자 계정) 하나를 공유하지만, 앱이 시작할 때
# 스스로 telemetry/command 전용 ACL 사용자를 등록해(app/core/redis_acl.py) 실제로는 채널별로
# 다른 자격증명을 쓴다(docs/planning/02_백엔드_아키텍처.md "채널 및 권한 분리").
REDIS_URL=redis://localhost:6379/0

TELEMETRY_STREAM_NAME=aeroops:telemetry:raw
TELEMETRY_CONSUMER_GROUP=telemetry-processors
TELEMETRY_REDIS_PASSWORD=telemetry-dev-pass

COMMAND_STREAM_NAME=aeroops:command:events
COMMAND_CONSUMER_GROUP=command-processors
COMMAND_REDIS_PASSWORD=command-dev-pass

# 빌드 메타데이터 (deployment 모듈, GET /system/build-info) — CI/Docker 빌드 시 주입한다.
GIT_SHA=local-dev
IMAGE_TAG=local-dev

# Auth (Identity 모듈, 8단계에서 적용)
JWT_SECRET_KEY=change-me-in-env
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
