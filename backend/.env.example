# FastAPI
APP_ENV=local
APP_HOST=0.0.0.0
APP_PORT=8000

# PostgreSQL / PostGIS
DATABASE_URL=postgresql+psycopg://aeroops:aeroops@postgres:5432/aeroops

# Redis Streams
REDIS_URL=redis://redis:6379/0

# Auth (Identity 모듈, 8단계에서 적용)
JWT_SECRET_KEY=change-me-in-env
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
