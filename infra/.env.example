# Docker Compose 전역 환경변수
POSTGRES_USER=aeroops
POSTGRES_PASSWORD=aeroops
POSTGRES_DB=aeroops

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# 배포 메타데이터(api 이미지 빌드 시 주입, GET /system/build-info로 조회). CI에서
# GIT_SHA=$(git rev-parse HEAD), IMAGE_TAG=<레지스트리 태그>로 채운다.
GIT_SHA=local-dev
IMAGE_TAG=local-dev
